  "cards": [
    {
      "dot": "emerald",
      "title": "Offline-first core",
      "items": [
        "Core reads and mutations complete against IndexedDB immediately.",
        "An ordered outbox reconciles through idempotent, cursor-based exchange."
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared application",
      "items": [
        "One Vue bundle runs as a PWA or inside Android and iOS Capacitor shells.",
        "Native bridges add background work, health data, speech, camera, timers, and alerts."
      ]
    },
    {
      "dot": "violet",
      "title": "Server authority",
      "items": [
        "The bearer-authenticated PHP API enforces ownership, validation, and merge rules.",
        "SQLite and private media remain server-controlled; AI and SMTP are optional outbound integrations."
      ]
    }
  ]
